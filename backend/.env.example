DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173
# Pilot-only live heat control. Store the SHA-256 hex digest, never the operator code.
LIVE_HEAT_OPERATOR_COMPETITION_ID=
LIVE_HEAT_OPERATOR_CODE_SHA256=
LIVE_HEAT_SESSION_SECRET=
# Keep true behind HTTPS; false is only for local HTTP development.
LIVE_HEAT_COOKIE_SECURE=true
# SameSite=Lax requires frontend and API to share a site (custom subdomains or proxy).
# List only proxy CIDRs that directly connect to the API before trusting X-Forwarded-For.
LIVE_HEAT_TRUSTED_PROXY_CIDRS=
DATABASE_PUBLIC_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWT_ALGORITHMS=
# Administrative OIDC identity exchange (Supabase Auth by default).
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_AUDIENCE=authenticated
ADMIN_OIDC_JWKS_URL=
ADMIN_OIDC_PROVIDER=supabase
ADMIN_SESSION_TTL_SECONDS=14400
# Keep true behind HTTPS; false is only for local HTTP development.
ADMIN_COOKIE_SECURE=true
